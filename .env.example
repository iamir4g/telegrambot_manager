# کپی روی سرور: cp .env.example .env  سپس مقادیر را عوض کنید.
# این فایل را هرگز با سکرت واقعی commit نکنید.

# --- API ---
DATABASE_URL=file:/data/finnap.db
PORT=3001
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
# برای پنل پشت همان دامنه (nginx): آدرس عمومی سایت
CORS_ORIGIN=https://panel.example.com
SETTINGS_ENCRYPTION_KEY=replace-with-32plus-char-encryption-key

# اولین استقرار: 1 بگذارید تا ادمین ساخته شود؛ بعد 0 کنید
RUN_SEED=1
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
SEED_ADMIN_NAME=مدیر فیناپ

# اختیاری — ترجیحاً از پنل تنظیم شود
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# --- Compose ---
HTTP_PORT=80
