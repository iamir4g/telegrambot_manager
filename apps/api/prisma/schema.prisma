generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum ContentStatus {
  DRAFT
  APPROVED
}

enum EscalationType {
  UNANSWERED
  TICKET_ISSUE
  SPONSORSHIP
  OTHER
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TelegramMode {
  LONG_POLLING
  WEBHOOK
}

enum OutboundTarget {
  CHANNEL
  PRIVATE
}

enum OutboundStatus {
  DRAFT
  SENT
  EDITED
  DELETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  dayGuideJson String  @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions   Session[]
  speakers   Speaker[]
  locations  Location[]
  sponsors   Sponsor[]
  links      EventLink[]
  faqs       FaqItem[]
  topics     TopicNode[]
  telegram   TelegramSettings?
  llm        LlmSettings?
  tickets    EscalationTicket[]
  conversations Conversation[]
  outboundMessages OutboundMessage[]
}

model Session {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String   @default("")
  hall        String   @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Speaker {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  title     String   @default("")
  bio       String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Location {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  address     String   @default("")
  mapUrl      String   @default("")
  notes       String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  tier      String   @default("")
  website   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventLink {
  id        String   @id @default(cuid())
  eventId   String
  key       String
  label     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
}

model FaqItem {
  id        String        @id @default(cuid())
  eventId   String
  question  String
  answer    String
  topicKey  String        @default("")
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  updatedBy String?
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model TopicNode {
  id              String   @id @default(cuid())
  eventId         String
  key             String
  title           String
  parentKey       String?
  keywordsJson    String   @default("[]")
  sampleQuestions String   @default("[]")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
}

model TelegramSettings {
  id                    String       @id @default(cuid())
  eventId               String       @unique
  botTokenEncrypted     String       @default("")
  botUsername           String       @default("")
  botId                 String       @default("")
  mode                  TelegramMode @default(LONG_POLLING)
  webhookUrl            String       @default("")
  webhookSecret         String       @default("")
  channelChatId         String       @default("")
  isEnabled             Boolean      @default(false)
  startMessage          String       @default("سلام! من دستیار رویداد فیناپ هستم. سؤالتان را بپرسید.")
  outOfScopeMessage     String       @default("این موضوع خارج از محدوده اطلاعات رویداد است. درخواست شما برای پیگیری ثبت شد.")
  escalateMessage       String       @default("درخواست شما ثبت شد و تیم فیناپ پیگیری می‌کند.")
  errorMessage          String       @default("موقتاً در پاسخ‌گویی اختلال داریم. کمی بعد دوباره تلاش کنید.")
  optInPrompt           String       @default("اگر مایلید پیام‌های مهم رویداد را دریافت کنید، «بله» را بفرستید.")
  quickLinksJson        String       @default("[]")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  event                 Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model LlmSettings {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  baseUrl            String   @default("https://api.openai.com/v1")
  apiKeyEncrypted    String   @default("")
  model              String   @default("gpt-4o-mini")
  maxTokens          Int      @default(500)
  temperature        Float    @default(0.2)
  systemPrompt       String   @default("تو دستیار رسمی رویداد فیناپ هستی. فقط از اطلاعات تأییدشده در context استفاده کن. قیمت، ظرفیت، زمان یا جزئیات تأییدنشده را حدس نزن. اگر مطمئن نیستی بگو اطلاعات کافی نداری.")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model AudienceConsent {
  id             String   @id @default(cuid())
  telegramUserId String   @unique
  username       String   @default("")
  optedIn        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Conversation {
  id             String   @id @default(cuid())
  eventId        String
  telegramUserId String
  username       String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([eventId, telegramUserId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  topicKey       String?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model EscalationTicket {
  id             String           @id @default(cuid())
  eventId        String
  type           EscalationType   @default(UNANSWERED)
  status         EscalationStatus @default(OPEN)
  telegramUserId String           @default("")
  username       String           @default("")
  subject        String
  body           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model LinkClick {
  id        String   @id @default(cuid())
  eventId   String
  linkKey   String
  createdAt DateTime @default(now())

  @@index([eventId, linkKey])
}

model OutboundMessage {
  id               String         @id @default(cuid())
  eventId          String
  target           OutboundTarget
  title            String         @default("")
  bodyHtml         String         @default("")
  bodyTelegramHtml String         @default("")
  status           OutboundStatus @default(DRAFT)
  createdById      String?
  sentAt           DateTime?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  event            Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries       OutboundDelivery[]

  @@index([eventId, target])
}

model OutboundDelivery {
  id                String   @id @default(cuid())
  outboundMessageId String
  chatId            String
  telegramMessageId String?
  status            String   @default("pending")
  error             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  outboundMessage   OutboundMessage @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)

  @@index([outboundMessageId])
}
